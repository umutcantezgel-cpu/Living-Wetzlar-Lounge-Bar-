---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import seoRoutes from '../../contracts/seo.routes.json';

const route = seoRoutes.routes.find(r => r.path === '/');
const seo = route?.languages['de-DE'];
const structuredData = route?.structuredData;

const navItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Getränke & Speisen', href: '/drinks-food' },
  { label: 'Über uns', href: '/about' },
  { label: 'Events', href: '/events' },
  { label: 'Galerie', href: '/gallery' },
  { label: 'Reservierung', href: '/reservation' },
  { label: 'Kontakt', href: '/contact' }
];
---

<BaseLayout
  title={seo?.title || ''}
  description={seo?.description || ''}
  canonical={seo?.canonical}
  structuredData={structuredData}
>
  <Navigation items={navItems} />

  <main id="main-content">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content container">
        <h1 class="hero-title">Willkommen im Living Wetzlar</h1>
        <p class="hero-subtitle">
          Erleben Sie exklusive Atmosphäre, Premium-Cocktails und unvergessliche Events im Herzen von Wetzlar.
        </p>
        <div class="hero-actions">
          <Button href="/reservation" variant="primary" size="lg">
            Tisch reservieren
          </Button>
          <Button href="/drinks-food" variant="outline" size="lg">
            Unsere Karte
          </Button>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features container">
      <h2 class="section-title scroll-reveal">Was uns auszeichnet</h2>
      <div class="features-grid">
        <article class="feature-card scroll-reveal" style="transition-delay: 0.1s">
          <div class="feature-icon" aria-hidden="true">🍸</div>
          <h3 class="feature-title">Premium-Cocktails</h3>
          <p class="feature-description">
            Handgefertigte Kreationen unserer erfahrenen Mixologen mit den besten Zutaten.
          </p>
        </article>

        <article class="feature-card scroll-reveal" style="transition-delay: 0.2s">
          <div class="feature-icon" aria-hidden="true">🎵</div>
          <h3 class="feature-title">Live-Events</h3>
          <p class="feature-description">
            Regelmäßige Live-Musik, DJ-Nights und exklusive Veranstaltungen.
          </p>
        </article>

        <article class="feature-card scroll-reveal" style="transition-delay: 0.3s">
          <div class="feature-icon" aria-hidden="true">✨</div>
          <h3 class="feature-title">Elegante Atmosphäre</h3>
          <p class="feature-description">
            Stilvolles Ambiente für besondere Momente und entspannte Abende.
          </p>
        </article>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
      <div class="cta-content container">
        <h2 class="cta-title">Bereit für ein unvergessliches Erlebnis?</h2>
        <p class="cta-description">
          Reservieren Sie jetzt Ihren Tisch und erleben Sie die Living Wetzlar Lounge Bar.
        </p>
        <Button href="/reservation" variant="primary" size="lg">
          Jetzt reservieren
        </Button>
      </div>
    </section>
  </main>

  <Footer />
  <ConsentBanner />
  <ScrollReveal />
</BaseLayout>

<style>
  /* Hero Section - Glassmorphism with Gold Accents */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    color: var(--color-text-inverted);
    padding: var(--space-20) var(--space-6);
    overflow: hidden;

    /* Multi-Layer Background */
    background:
      /* Layer 3: Ambient Dark Gradient */
      linear-gradient(135deg,
        rgba(26, 26, 26, 0.95) 0%,
        rgba(38, 38, 38, 0.88) 50%,
        rgba(77, 77, 77, 0.92) 100%
      ),
      /* Layer 2: Gold Radial Glow */
      radial-gradient(
        ellipse 800px 600px at 25% 30%,
        rgba(212, 175, 55, 0.15) 0%,
        transparent 70%
      ),
      /* Layer 1: Dark Base */
      linear-gradient(to bottom, #0D0D0D, #1A1A1A);

    background-color: #1A1A1A; /* Fallback */
  }

  /* Glassmorphism Overlay */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(80px) saturate(150%);
    -webkit-backdrop-filter: blur(80px) saturate(150%);
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 56rem;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(var(--font-size-3xl), 5vw, var(--font-size-6xl));
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-6);
    line-height: 1.1;
    letter-spacing: -0.02em;

    /* Gold Gradient Text */
    background: linear-gradient(
      135deg,
      #F4DD8B 0%,
      #D4AF37 50%,
      #B8942A 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 8px rgba(212, 175, 55, 0.3));
  }

  .hero-subtitle {
    font-size: clamp(var(--font-size-lg), 2vw, var(--font-size-2xl));
    color: var(--color-neutral-300);
    margin-bottom: var(--space-8);
    line-height: 1.6;
    letter-spacing: 0.01em;
  }

  /* Gold Text Highlights */
  .text-highlight {
    color: #F4DD8B;
    font-weight: var(--font-weight-semibold);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Features Section */
  .features {
    padding: var(--space-20) var(--space-6);
  }

  .section-title {
    text-align: center;
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-12);
    color: var(--color-text-primary);
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr); /* Tablet: 2 Spalten */
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr); /* Desktop: 3 Spalten */
    }
  }

  /* Glassmorphic Feature Cards */
  .feature-card {
    text-align: center;
    padding: var(--space-6);
    border-radius: var(--card-radius);

    /* Glassmorphism */
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(212, 175, 55, 0.2);

    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.05),
      0 10px 15px rgba(0, 0, 0, 0.1);

    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .feature-card:hover {
    transform: translateY(-8px) scale(1.02);
    background: rgba(255, 255, 255, 0.75);
    border-color: rgba(212, 175, 55, 0.6);
    box-shadow:
      0 8px 12px rgba(0, 0, 0, 0.1),
      0 20px 40px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(212, 175, 55, 0.3),
      0 0 30px rgba(212, 175, 55, 0.4);
  }

  .feature-card:focus-within {
    outline: 3px solid var(--color-brand-primary);
    outline-offset: 4px;
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: var(--space-4);
  }

  .feature-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-3);
    color: var(--color-brand-primary);
  }

  .feature-description {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* CTA Section */
  .cta {
    background-color: var(--color-brand-primary);
    color: var(--color-text-inverted);
    padding: var(--space-16) var(--space-6);
  }

  .cta-content {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto;
  }

  .cta-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-4);
  }

  .cta-description {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-6);
    line-height: var(--line-height-relaxed);
    opacity: 0.95;
  }
</style>
