---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const navItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Getränke & Speisen', href: '/drinks-food' },
  { label: 'Über uns', href: '/about' },
  { label: 'Events', href: '/events' },
  { label: 'Galerie', href: '/gallery' },
  { label: 'Reservierung', href: '/reservation' },
  { label: 'Kontakt', href: '/contact' }
];
---

<BaseLayout
  title="Impressum | Living Wetzlar"
  description="Impressum und rechtliche Angaben der Living Wetzlar Lounge Bar."
  robots="noindex, follow"
>
  <Navigation items={navItems} />

  <main id="main-content" class="container legal-page">
    <h1>Impressum</h1>

    <section>
      <h2>Angaben gemäß § 5 TMG</h2>
      <p>
        <strong>Living Wetzlar Lounge Bar GmbH</strong><br>
        Musterstraße 123<br>
        35578 Wetzlar<br>
        Deutschland
      </p>
    </section>

    <section>
      <h2>Vertreten durch</h2>
      <p>Geschäftsführer: Max Mustermann (TODO: Anpassen)</p>
    </section>

    <section>
      <h2>Kontakt</h2>
      <p>
        Telefon: <a href="tel:+496441123456">+49 6441 123456</a><br>
        E-Mail: <a href="mailto:info@living-wetzlar.de">info@living-wetzlar.de</a>
      </p>
    </section>

    <section>
      <h2>Registereintrag</h2>
      <p>
        Eintragung im Handelsregister<br>
        Registergericht: Amtsgericht Wetzlar (TODO: Anpassen)<br>
        Registernummer: HRB 12345 (TODO: Anpassen)
      </p>
    </section>

    <section>
      <h2>Umsatzsteuer-ID</h2>
      <p>
        Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG:<br>
        DE123456789 (TODO: Anpassen)
      </p>
    </section>

    <section>
      <h2>Verantwortlich für den Inhalt</h2>
      <p>
        Max Mustermann (TODO: Anpassen)<br>
        Musterstraße 123<br>
        35578 Wetzlar
      </p>
    </section>

    <section>
      <h2>EU-Streitschlichtung</h2>
      <p>
        Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:<br>
        <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer">
          https://ec.europa.eu/consumers/odr/
        </a><br>
        Unsere E-Mail-Adresse finden Sie oben im Impressum.
      </p>
    </section>

    <section>
      <h2>Verbraucherstreitbeilegung / Universalschlichtungsstelle</h2>
      <p>
        Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-page {
    padding: var(--space-12) var(--space-6);
    max-width: 48rem;
  }

  .legal-page h1 {
    font-size: var(--font-size-4xl);
    margin-bottom: var(--space-8);
  }

  .legal-page h2 {
    font-size: var(--font-size-2xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    color: var(--color-brand-primary);
  }

  .legal-page section {
    margin-bottom: var(--space-6);
  }

  .legal-page p {
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-3);
  }
</style>
