---
interface Props {
  quote: string;
  author: string;
  role?: string;
  image?: string;
  rating?: number;
}

const { quote, author, role, image, rating } = Astro.props;
---

<div class="testimonial scroll-reveal">
  {rating && (
    <div class="testimonial-rating" aria-label={`Bewertung: ${rating} von 5 Sternen`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <svg
          class={`star ${i < rating ? 'filled' : ''}`}
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>
  )}

  <blockquote class="testimonial-quote">
    <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
    </svg>
    <p class="quote-text">{quote}</p>
  </blockquote>

  <div class="testimonial-author">
    {image && (
      <img
        src={image}
        alt={author}
        class="author-image"
        width="48"
        height="48"
        loading="lazy"
      />
    )}
    <div class="author-info">
      <cite class="author-name">{author}</cite>
      {role && <p class="author-role">{role}</p>}
    </div>
  </div>
</div>

<style>
  .testimonial {
    background: var(--testimonial-bg);
    padding: var(--testimonial-padding);
    border-radius: var(--testimonial-radius);
    box-shadow: var(--testimonial-shadow);
    position: relative;
  }

  .testimonial-rating {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .star {
    color: var(--color-neutral-300);
    transition: color var(--duration-200) var(--ease-out);
  }

  .star.filled {
    color: var(--color-brand-primary);
  }

  .testimonial-quote {
    margin: 0 0 var(--space-6) 0;
    position: relative;
  }

  .quote-icon {
    color: var(--testimonial-quote-color);
    opacity: 0.2;
    margin-bottom: var(--space-3);
  }

  .quote-text {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-primary);
    font-style: italic;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .author-image {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid var(--color-brand-primary);
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    display: block;
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    font-style: normal;
  }

  .author-role {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-1);
  }
</style>
