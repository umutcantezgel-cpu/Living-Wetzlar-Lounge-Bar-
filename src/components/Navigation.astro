---
interface NavItem {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <nav class="navigation container" role="navigation" aria-label="Hauptnavigation">
    <div class="nav-wrapper">
      <!-- Logo -->
      <div class="nav-brand">
        <a href="/" aria-label="Living Wetzlar – Startseite">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
            <rect width="48" height="48" rx="8" fill="currentColor" class="text-brand-primary-500"/>
            <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="white" font-size="24" font-weight="700">LW</text>
          </svg>
          <span class="nav-brand-text">Living Wetzlar</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Menü öffnen"
      >
        <svg class="nav-toggle-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
          <path class="nav-toggle-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          <path class="nav-toggle-close hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Navigation Menu -->
      <div id="nav-menu" class="nav-menu" role="menu">
        <ul class="nav-list" role="none">
          {items.map((item) => {
            const isCurrent = currentPath === item.href || currentPath.startsWith(item.href + '/');
            return (
              <li role="none">
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={isCurrent ? 'page' : undefined}
                  role="menuitem"
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </nav>
</header>

<style>
  /* Glassmorphic Sticky Navigation */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-40);

    /* Glassmorphism Effect */
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);

    /* Gold Border Accent */
    border-bottom: 1px solid rgba(212, 175, 55, 0.15);

    /* Soft Shadow */
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.04),
      0 8px 16px rgba(0, 0, 0, 0.08);
  }

  /* Dark Mode Support (future-proof) */
  @media (prefers-color-scheme: dark) {
    .site-header {
      background: rgba(26, 26, 26, 0.88);
      border-bottom-color: rgba(212, 175, 55, 0.25);
    }
  }

  .navigation {
    height: var(--nav-height);
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-brand {
    flex-shrink: 0;
  }

  .nav-brand a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text-primary);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-xl);
  }

  .nav-brand-text {
    font-family: var(--text-heading-font);
  }

  /* Mobile Toggle */
  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    background: none;
    border: none;
    color: var(--color-text-primary);
    min-width: 2.5rem;
    min-height: 2.5rem;
    border-radius: var(--radius-md);
  }

  .nav-toggle:hover {
    background-color: var(--color-interactive-hover);
  }

  .nav-toggle:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-open {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-close {
    display: block;
  }

  /* Navigation Menu */
  .nav-menu {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-surface-base);
    transform: translateX(-100%);
    transition: transform var(--duration-300) var(--ease-out);
    overflow-y: auto;
    box-shadow: var(--shadow-lg);
  }

  .nav-menu[data-open="true"] {
    transform: translateX(0);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    gap: var(--space-2);
    list-style: none;
    margin: 0;
  }

  .nav-link {
    display: block;
    padding: var(--nav-link-padding);
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-md);
    transition: background-color var(--duration-200) var(--ease-out);
  }

  .nav-link:hover {
    background-color: var(--nav-link-hover-bg);
    text-decoration: none;
  }

  .nav-link[aria-current="page"] {
    background-color: var(--color-brand-primary-light);
    color: var(--color-brand-primary);
    font-weight: var(--font-weight-semibold);
  }

  .nav-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: calc(var(--focus-ring-offset) * -1);
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }

    .nav-menu {
      position: static;
      transform: none;
      background: none;
      box-shadow: none;
      overflow: visible;
    }

    .nav-list {
      flex-direction: row;
      padding: 0;
      gap: var(--space-1);
    }

    .nav-link {
      padding: var(--space-2) var(--space-4);
    }
  }
</style>

<script>
  // Navigation Mobile Menu Toggle - Optimized
  (() => {
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const menu = document.querySelector<HTMLElement>('.nav-menu');
    const header = document.querySelector('.site-header');

    if (!toggle || !menu) return;

    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Menü öffnen');
      menu.setAttribute('data-open', 'false');
    };

    const openMenu = () => {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Menü schließen');
      menu.setAttribute('data-open', 'true');
      menu.querySelector<HTMLAnchorElement>('.nav-link')?.focus();
    };

    // Toggle menu
    toggle.addEventListener('click', () => {
      toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
    });

    // Close on link click
    menu.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggle.focus();
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (toggle.getAttribute('aria-expanded') === 'true' &&
          !header?.contains(e.target as Node)) {
        closeMenu();
      }
    });
  })();
</script>
