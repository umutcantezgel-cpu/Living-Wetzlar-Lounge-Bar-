---
interface NavItem {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <nav class="navigation container" role="navigation" aria-label="Hauptnavigation">
    <div class="nav-wrapper">
      <!-- Logo -->
      <div class="nav-brand">
        <a href="/" aria-label="Living Wetzlar – Startseite">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
            <rect width="48" height="48" rx="8" fill="currentColor" class="text-brand-primary-500"/>
            <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="white" font-size="24" font-weight="700">LW</text>
          </svg>
          <span class="nav-brand-text">Living Wetzlar</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Menü öffnen"
      >
        <svg class="nav-toggle-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
          <path class="nav-toggle-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          <path class="nav-toggle-close hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Navigation Menu -->
      <div id="nav-menu" class="nav-menu" role="menu">
        <ul class="nav-list" role="none">
          {items.map((item) => {
            const isCurrent = currentPath === item.href || currentPath.startsWith(item.href + '/');
            return (
              <li role="none">
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={isCurrent ? 'page' : undefined}
                  role="menuitem"
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    background-color: var(--nav-bg);
    box-shadow: var(--nav-shadow);
    z-index: var(--z-40);
  }

  .navigation {
    height: var(--nav-height);
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-brand {
    flex-shrink: 0;
  }

  .nav-brand a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text-primary);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-xl);
  }

  .nav-brand-text {
    font-family: var(--text-heading-font);
  }

  /* Mobile Toggle */
  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    background: none;
    border: none;
    color: var(--color-text-primary);
    min-width: 2.5rem;
    min-height: 2.5rem;
    border-radius: var(--radius-md);
  }

  .nav-toggle:hover {
    background-color: var(--color-interactive-hover);
  }

  .nav-toggle:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-open {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-close {
    display: block;
  }

  /* Navigation Menu */
  .nav-menu {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-surface-base);
    transform: translateX(-100%);
    transition: transform var(--duration-300) var(--ease-out);
    overflow-y: auto;
    box-shadow: var(--shadow-lg);
  }

  .nav-menu[data-open="true"] {
    transform: translateX(0);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    gap: var(--space-2);
    list-style: none;
    margin: 0;
  }

  .nav-link {
    display: block;
    padding: var(--nav-link-padding);
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-md);
    transition: background-color var(--duration-200) var(--ease-out);
  }

  .nav-link:hover {
    background-color: var(--nav-link-hover-bg);
    text-decoration: none;
  }

  .nav-link[aria-current="page"] {
    background-color: var(--color-brand-primary-light);
    color: var(--color-brand-primary);
    font-weight: var(--font-weight-semibold);
  }

  .nav-link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: calc(var(--focus-ring-offset) * -1);
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }

    .nav-menu {
      position: static;
      transform: none;
      background: none;
      box-shadow: none;
      overflow: visible;
    }

    .nav-list {
      flex-direction: row;
      padding: 0;
      gap: var(--space-1);
    }

    .nav-link {
      padding: var(--space-2) var(--space-4);
    }
  }
</style>

<script>
  // Navigation Mobile Menu Toggle
  class NavigationMenu extends HTMLElement {
    private toggle: HTMLButtonElement | null = null;
    private menu: HTMLElement | null = null;
    private links: NodeListOf<HTMLAnchorElement> | null = null;

    constructor() {
      super();
    }

    connectedCallback() {
      this.toggle = this.querySelector('.nav-toggle');
      this.menu = this.querySelector('.nav-menu');
      this.links = this.querySelectorAll('.nav-link');

      if (this.toggle && this.menu) {
        this.toggle.addEventListener('click', this.handleToggle.bind(this));
        this.links?.forEach(link => {
          link.addEventListener('click', this.handleLinkClick.bind(this));
        });

        // Close on Escape
        document.addEventListener('keydown', this.handleEscape.bind(this));

        // Close on outside click
        document.addEventListener('click', this.handleOutsideClick.bind(this));
      }
    }

    private handleToggle() {
      const isExpanded = this.toggle?.getAttribute('aria-expanded') === 'true';
      this.toggle?.setAttribute('aria-expanded', String(!isExpanded));
      this.menu?.setAttribute('data-open', String(!isExpanded));

      if (!isExpanded) {
        this.toggle?.setAttribute('aria-label', 'Menü schließen');
        // Focus first link
        this.links?.[0]?.focus();
      } else {
        this.toggle?.setAttribute('aria-label', 'Menü öffnen');
      }
    }

    private handleLinkClick() {
      // Close menu when link is clicked
      this.toggle?.setAttribute('aria-expanded', 'false');
      this.menu?.setAttribute('data-open', 'false');
      this.toggle?.setAttribute('aria-label', 'Menü öffnen');
    }

    private handleEscape(event: KeyboardEvent) {
      if (event.key === 'Escape' && this.toggle?.getAttribute('aria-expanded') === 'true') {
        this.handleToggle();
        this.toggle?.focus();
      }
    }

    private handleOutsideClick(event: Event) {
      const target = event.target as Node;
      if (
        this.toggle?.getAttribute('aria-expanded') === 'true' &&
        !this.contains(target)
      ) {
        this.handleToggle();
      }
    }

    disconnectedCallback() {
      this.toggle?.removeEventListener('click', this.handleToggle.bind(this));
      document.removeEventListener('keydown', this.handleEscape.bind(this));
      document.removeEventListener('click', this.handleOutsideClick.bind(this));
    }
  }

  if (typeof window !== 'undefined' && !customElements.get('navigation-menu')) {
    customElements.define('navigation-menu', NavigationMenu);
  }

  // Wrap navigation in custom element
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('.site-header');
    if (nav && !nav.closest('navigation-menu')) {
      const wrapper = document.createElement('navigation-menu');
      nav.parentNode?.insertBefore(wrapper, nav);
      wrapper.appendChild(nav);
    }
  });
</script>
