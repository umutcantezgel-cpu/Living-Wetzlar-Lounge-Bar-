---
interface Props {
  variant?: 'default' | 'elevated' | 'outlined' | 'glass';
  hover?: 'lift' | 'glow' | 'scale' | 'none';
  className?: string;
}

const { variant = 'default', hover = 'lift', className = '' } = Astro.props;

const variantClasses = {
  default: 'bg-white border border-neutral-200',
  elevated: 'bg-white shadow-premium',
  outlined: 'bg-transparent border-2 border-brand-primary-500',
  glass: 'glass'
};

const hoverClasses = {
  lift: 'hover-lift',
  glow: 'hover-glow',
  scale: 'hover-scale',
  none: ''
};

const cardClasses = `
  rounded-lg overflow-hidden transition-all duration-300
  ${variantClasses[variant]}
  ${hoverClasses[hover]}
  ${className}
`.trim();
---

<article class={cardClasses}>
  <slot />
</article>

<style>
  article {
    container-type: inline-size;
  }
</style>
