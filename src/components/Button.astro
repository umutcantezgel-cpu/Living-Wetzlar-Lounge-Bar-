---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  fullWidth = false,
  ariaLabel
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = `btn btn-${variant} btn-${size} ${fullWidth ? 'btn-full-width' : ''}`.trim();
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  aria-label={ariaLabel}
  aria-disabled={disabled ? 'true' : undefined}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border: 2px solid transparent;
    border-radius: var(--btn-radius);
    transition: var(--btn-transition);
    cursor: pointer;
    text-align: center;
    white-space: nowrap;
  }

  .btn:disabled,
  .btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Sizes */
  .btn-sm {
    padding: var(--btn-padding-sm);
    font-size: var(--font-size-sm);
    min-height: var(--btn-min-height-sm);
  }

  .btn-md {
    padding: var(--btn-padding-md);
    font-size: var(--font-size-base);
    min-height: var(--btn-min-height-md);
  }

  .btn-lg {
    padding: var(--btn-padding-lg);
    font-size: var(--font-size-lg);
    min-height: var(--btn-min-height-lg);
  }

  /* Variants */
  .btn-primary {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #D4AF37 0%, #B8942A 100%);
    color: var(--color-white);
    box-shadow: 0 4px 14px rgba(212, 175, 55, 0.4);
  }

  .btn-primary:hover:not(:disabled) {
    background: linear-gradient(135deg, #E4B724 0%, #D4AF37 100%);
    transform: translateY(-2px);
    box-shadow:
      0 8px 20px rgba(212, 175, 55, 0.5),
      0 0 30px rgba(212, 175, 55, 0.3);
  }

  /* Ripple Effect on Click */
  .btn-primary::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
  }

  .btn-primary:active::after {
    width: 300px;
    height: 300px;
  }

  .btn-secondary {
    background-color: var(--color-brand-secondary);
    color: var(--color-white);
  }

  .btn-secondary:hover:not(:disabled) {
    background-color: var(--color-brand-secondary-hover);
    transform: translateY(-1px);
  }

  .btn-outline {
    background-color: transparent;
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary);
  }

  .btn-outline:hover:not(:disabled) {
    background-color: var(--color-brand-primary);
    color: var(--color-white);
  }

  .btn-ghost {
    background-color: transparent;
    color: var(--color-text-primary);
  }

  .btn-ghost:hover:not(:disabled) {
    background-color: var(--color-interactive-hover);
  }

  .btn-full-width {
    width: 100%;
  }
</style>
