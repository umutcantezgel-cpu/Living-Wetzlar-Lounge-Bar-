---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Company Info -->
      <div class="footer-section">
        <h3 class="footer-heading">Living Wetzlar</h3>
        <p class="footer-text">
          Premium Lounge Bar im Herzen von Wetzlar – elegante Atmosphäre, exquisite Getränke, unvergessliche Events.
        </p>
        <div class="footer-social">
          <a href="https://instagram.com/livingwetzlar" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="24" height="24" fill="currentColor" aria-hidden="true"><use href="#icon-instagram"></use></svg>
          </a>
          <a href="https://facebook.com/livingwetzlar" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="24" height="24" fill="currentColor" aria-hidden="true"><use href="#icon-facebook"></use></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-section">
        <h3 class="footer-heading">Navigation</h3>
        <nav aria-label="Footer Navigation">
          <ul class="footer-links">
            <li><a href="/">Startseite</a></li>
            <li><a href="/drinks-food">Getränke & Speisen</a></li>
            <li><a href="/events">Events</a></li>
            <li><a href="/contact">Kontakt</a></li>
          </ul>
        </nav>
      </div>

      <!-- Contact -->
      <div class="footer-section">
        <h3 class="footer-heading">Kontakt</h3>
        <address class="footer-address">
          <p>Musterstraße 123<br>35578 Wetzlar</p>
          <p><a href="tel:+496441123456">+49 6441 123456</a></p>
          <p><a href="mailto:info@living-wetzlar.de">info@living-wetzlar.de</a></p>
        </address>
      </div>

      <!-- Legal -->
      <div class="footer-section">
        <h3 class="footer-heading">Rechtliches</h3>
        <ul class="footer-links">
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutzerklärung</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Living Wetzlar Lounge Bar. Alle Rechte vorbehalten.</p>
    </div>
  </div>
</footer>

<!-- SVG Icons (hidden) -->
