---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  structuredData?: object;
  lang?: string;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  structuredData,
  lang = 'de-DE'
} = Astro.props;

const siteUrl = 'https://living-wetzlar.de';
const fullCanonical = canonical || `${siteUrl}${Astro.url.pathname}`;
const ogImage = `${siteUrl}/assets/img/og-image.jpg`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Critical Performance Hints -->
  <link rel="preconnect" href={siteUrl} crossorigin>
  <link rel="dns-prefetch" href={siteUrl}>

  <!-- Preload Critical Assets (LCP Optimization) -->
  <!-- TODO: Add actual font files once hosted -->
  <!-- <link rel="preload" as="font" type="font/woff2" href="/assets/font/inter-var.woff2" crossorigin> -->
  <!-- <link rel="preload" as="font" type="font/woff2" href="/assets/font/playfair-var.woff2" crossorigin> -->

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={fullCanonical}>
  <meta name="robots" content={robots}>

  <!-- Theme Color (Critical for PWA) -->
  <meta name="theme-color" content="#D4AF37">

  <!-- Favicon (Optimized Order) -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Web Manifest -->
  <link rel="manifest" href="/site.webmanifest">

  <!-- Open Graph / Facebook (Deferred) -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={fullCanonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content={lang}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={fullCanonical}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Additional Icons -->
  <link rel="alternate icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Structured Data -->
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
</head>
<body>
  <!-- Skip to main content link -->
  <a href="#main-content" class="skip-link">
    Zum Hauptinhalt springen
  </a>

  <!-- Slot for page content -->
  <slot />

  <!-- No JavaScript Warning -->
  <noscript>
    <div class="no-js-warning" role="alert">
      <p>Diese Website funktioniert am besten mit aktiviertem JavaScript.</p>
    </div>
  </noscript>
</body>
</html>
